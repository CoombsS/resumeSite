@page "/submitResume"
@using System.ComponentModel.DataAnnotations
@using MySql.Data.MySqlClient

<PageTitle>Submit Resume</PageTitle>

<h1>Resume Submission Form</h1>

<EditForm Model="@resumeModel" OnValidSubmit="HandleValidSubmit" FormName="resumeForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Full Name</label>
        <InputText class="form-control" @bind-Value="resumeModel.Name" @bind-Value:event="oninput" />
    </div>

    <div class="mb-3">
        <label>GitHub</label>
        <InputText class="form-control" @bind-Value="resumeModel.GitHub" @bind-Value:event="oninput" />
    </div>

    <div class="mb-3">
        <label>Email</label>
        <InputText class="form-control" @bind-Value="resumeModel.Email" @bind-Value:event="oninput" />
    </div>

    <div class="mb-3">
        <label>City</label>
        <InputText class="form-control" @bind-Value="resumeModel.City" @bind-Value:event="oninput" />
    </div>

    <div class="mb-3">
        <label>State</label>
        <InputText class="form-control" @bind-Value="resumeModel.State" @bind-Value:event="oninput" />
    </div>

    <div class="mb-3">
        <label>Past Experience 1</label>
        <InputText class="form-control" @bind-Value="resumeModel.PastExperience1" @bind-Value:event="oninput" />
    </div>

    <div class="mb-3">
        <label>Past Experience 2</label>
        <InputText class="form-control" @bind-Value="resumeModel.PastExperience2" @bind-Value:event="oninput" />
    </div>

    <div class="mb-3">
        <label>Past Experience 3</label>
        <InputText class="form-control" @bind-Value="resumeModel.PastExperience3" @bind-Value:event="oninput" />
    </div>

    <div class="mb-3">
        <label>Past Experience Details 1</label>
        <InputTextArea class="form-control" @bind-Value="resumeModel.PastExperienceDetails1" @bind-Value:event="oninput" />
    </div>

    <div class="mb-3">
        <label>Past Experience Details 2</label>
        <InputTextArea class="form-control" @bind-Value="resumeModel.PastExperienceDetails2" @bind-Value:event="oninput" />
    </div>

    <div class="mb-3">
        <label>Past Experience Details 3</label>
        <InputTextArea class="form-control" @bind-Value="resumeModel.PastExperienceDetails3" @bind-Value:event="oninput" />
    </div>

    <div class="mb-3">
        <label>Project 1</label>
        <InputText class="form-control" @bind-Value="resumeModel.Project1" @bind-Value:event="oninput" />
    </div>

    <div class="mb-3">
        <label>Project 2</label>
        <InputText class="form-control" @bind-Value="resumeModel.Project2" @bind-Value:event="oninput" />
    </div>

    <div class="mb-3">
        <label>Project 3</label>
        <InputText class="form-control" @bind-Value="resumeModel.Project3" @bind-Value:event="oninput" />
    </div>

    <div class="mb-3">
        <label>Project Details 1</label>
        <InputTextArea class="form-control" @bind-Value="resumeModel.ProjectDetails1" @bind-Value:event="oninput" />
    </div>

    <div class="mb-3">
        <label>Project Details 2</label>
        <InputTextArea class="form-control" @bind-Value="resumeModel.ProjectDetails2" @bind-Value:event="oninput" />
    </div>

    <div class="mb-3">
        <label>Project Details 3</label>
        <InputTextArea class="form-control" @bind-Value="resumeModel.ProjectDetails3" @bind-Value:event="oninput" />
    </div>

    <div class="mb-3">
        <label>Languages</label>
        <InputTextArea class="form-control" @bind-Value="resumeModel.Languages" @bind-Value:event="oninput" />
    </div>

    <div class="mb-3">
        <label>Technology</label>
        <InputTextArea class="form-control" @bind-Value="resumeModel.Technology" @bind-Value:event="oninput" />
    </div>

    <div class="mb-3">
        <label>Personal Skills</label>
        <InputTextArea class="form-control" @bind-Value="resumeModel.PersonalSkills" @bind-Value:event="oninput" />
    </div>

    <button class="btn btn-success" type="submit">Submit</button>
</EditForm>

@if (isSubmitted)
{
    <div class="alert alert-success mt-4">
        <strong>Resume submitted successfully!</strong>
    </div>
}

@if (submitError != null)
{
    <div class="alert alert-danger mt-4">
        <strong>Error submitting resume:</strong> @submitError
    </div>
}

